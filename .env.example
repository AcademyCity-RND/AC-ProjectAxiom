# ==============================================================================
# AXIOM DEFENSE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin berkas ini menjadi .env (cp .env.example .env) sebelum menjalankan sistem.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Kunci rahasia untuk enkripsi token JWT (Wajib diganti saat deploy ke VPS produksi)
SECRET_KEY=axiom-military-cyber-threat-intelligence-key-2026

# ------------------------------------------------------------------------------
# 2. AI ENGINE & EXPLAINABLE XAI (GROQ LPU)
# ------------------------------------------------------------------------------
# Dapatkan API Key gratis di https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 3. KREDENSIAL SCRAPER MEDIA SOSIAL (1 AKUN BURNER / COOKIE)
# ------------------------------------------------------------------------------
# Platform X (Twitter): Ambil cookie dari browser F12 -> Application -> Storage -> Cookies -> x.com
TWITTER_USERNAME=your_twitter_username
TWITTER_AUTH_TOKEN=your_auth_token_cookie_here
TWITTER_CT0=your_ct0_cookie_here

# Platform Instagram (Opsional): Sistem sudah memiliki Zero-Auth Scraper otomatis.
# Isi sessionid hanya jika ingin fallback penelusuran balasan berantai (authenticated):
INSTAGRAM_SESSIONID=

# Platform YouTube: 100% Zero-Auth otomatis via Innertube (Tanpa butuh API key atau login)

# ------------------------------------------------------------------------------
# 4. DATABASE & STORAGE (POSTGRESQL & CHROMADB)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=axiom_db
# Nama host database (Mendukung POSTGRES_SERVER atau POSTGRES_HOST)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
# Port binding di host OS (default: 5434 untuk mencegah konflik PostgreSQL lokal)
POSTGRES_HOST_PORT=5434

CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ------------------------------------------------------------------------------
# 5. MODE PENGUJIAN & DEVELOPMENT
# ------------------------------------------------------------------------------
# Set true jika ingin demonstrasi offline simulasi tanpa koneksi internet sama sekali
SCRAPER_OFFLINE_MODE=false
