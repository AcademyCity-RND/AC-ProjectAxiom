# ==============================================================================
# AXIOM DEFENSE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin berkas ini menjadi .env (cp .env.example .env) dan sesuaikan nilainya.
# ==============================================================================

# 1. AI SYNTHESIS & EXPLAINABLE XAI (GROQ LLAMA 3.3)
# Dapatkan API Key gratis di https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# 2. X (TWITTER) REALTIME SCRAPING (1 AKUN BURNER / COOKIE AMAN)
# Ambil dari browser x.com: Buka F12 -> Application -> Storage -> Cookies -> https://x.com
TWITTER_USERNAME=your_twitter_username
TWITTER_AUTH_TOKEN=your_auth_token_cookie_here
TWITTER_CT0=your_ct0_cookie_here

# 3. INSTAGRAM REALTIME SCRAPING (1 AKUN BURNER / COOKIE AMAN)
# Ambil dari browser instagram.com: Buka F12 -> Application -> Storage -> Cookies -> sessionid
INSTAGRAM_SESSIONID=your_sessionid_cookie_here
INSTAGRAM_SETTINGS_PATH=data/sessions/ig_settings.json

# 4. YOUTUBE REALTIME SCRAPING
# (Kanal YouTube berjalan 100% Realtime otomatis via Innertube tanpa butuh API key atau login)

# 5. CORE DATABASE CONFIGURATION (POSTGRESQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=axiom_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port eksposur di sisi host OS (default: 5434 untuk mencegah konflik port 5432 lokal)
POSTGRES_HOST_PORT=5434

# 6. VECTOR DATABASE & SCRAPER ENGINE
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=actor_narratives

# Mode Offline (Set true jika ingin menjalankan demo tanpa koneksi internet sama sekali)
SCRAPER_OFFLINE_MODE=false
